# Docker Compose secrets
DB_USER=postgres
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_NAME=AssetManagementDb
RABBITMQ_USER=admin
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# API runtime secrets (set these in shell, CI/CD, or user-secrets)
ConnectionStrings__Database=Host=localhost;Port=5433;Database=AssetManagementDb;Username=postgres;Password=CHANGE_ME_DB_PASSWORD
Jwt__Issuer=AssetApi
Jwt__Audience=AssetFrontend
Jwt__Key=CHANGE_ME_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS
RabbitMQ__Host=amqp://localhost:5672/
RabbitMQ__Username=admin
RabbitMQ__Password=CHANGE_ME_RABBITMQ_PASSWORD
